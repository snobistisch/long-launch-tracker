# Optional production RPC. The public default is rate-limited and not an archive node.
LONG_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Operational tuning. Log queries are always scoped to one launcher and topic0.
LONG_RPC_BLOCK_SPAN=20000
LONG_RPC_CONCURRENCY=2
LONG_RPC_REQUESTS_PER_SECOND=8
LONG_CONFIRMATIONS=64
LONG_DEFAULT_LOOKBACK_BLOCKS=100000
LONG_WATCH_INTERVAL_MS=15000

LONG_DB_PATH=./data/long-tracker.sqlite
ROBINHOOD_RHJ_BASE_URL=https://api.robinhood.com/rhj
